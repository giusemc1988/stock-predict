{
  "name": "stock-predict",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "learn:build": "vite build --ssr scripts/learn-cycle.ts --outDir .learn --emptyOutDir --logLevel warn",
    "practice": "vite build --ssr scripts/practice-cycle.ts --outDir .practice --emptyOutDir --logLevel warn && node .practice/practice-cycle.js",
    "learn": "npm run learn:build && node .learn/learn-cycle.js",
    "test": "node scripts/journal.test.ts && node scripts/practice.test.ts && vite build --ssr scripts/practice-picks.test.ts --outDir .learn/test --emptyOutDir --logLevel warn && node .learn/test/practice-picks.test.js && npm run learn:build && node .learn/learn-cycle.js --demo --cycles 3 --out .learn/demo.json"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
